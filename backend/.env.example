# Server
PORT=3000

# MySQL — option A: single connection URL (recommended for hosted DBs like TiDB/Aiven)
MYSQL_URL=mysql://user:password@host:4000/database?ssl=true

# MySQL — option B: individual vars (used if MYSQL_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=ai_compass

# Auth
JWT_SECRET=generate_a_long_random_string_here

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200,https://your-frontend.vercel.app
